# CircuitMentor — .gitignore

# ── Model weights (too large for GitHub) ─────────────────────────────────────
models/
*.safetensors
*.bin
*.pth
*.pt
final_model/
final_lora_adapter/
experiments/
checkpoint-*/
emergency_checkpoint/

# ── Datasets (rebuild with build_dataset.py) ──────────────────────────────────
embedded_dataset/
datasets/
*.jsonl
raw_50k.jsonl

# ── HuggingFace cache ─────────────────────────────────────────────────────────
hf_cache/
~/.cache/huggingface/

# ── Session data (auto-deleted, never commit) ─────────────────────────────────
sessions/
/mnt/circuitmentor/sessions/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
nohup.out

# ── Config with secrets ───────────────────────────────────────────────────────
config.json
.env
*.env
ngrok.yml
public_url.txt
CURRENT_URL.txt
circuitmentor.pid

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.venv/
venv/
env/
vlsi_env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints
*.ipynb

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Training artifacts ────────────────────────────────────────────────────────
training_summary.json
train_tutor_*.log
wandb/
runs/
tensorboard/

# ── Temp ─────────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
fix_backend.py
fix_prompt.py
